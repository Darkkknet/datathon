# Скопируйте этот файл в .env и заполните ОДИН из ключей.
# Без ключей система работает в MOCK-режиме (заглушки).

# Вариант 1 (бесплатно): Gemini — ключ на aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Вариант 2 (платно, качество выше): Claude — ключ на platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
MODEL=claude-sonnet-5-5

# Если заданы оба ключа, используется Claude. Принудительно: PROVIDER=gemini | anthropic | mock
PROVIDER=

# Ссылка GET организаторов БЕЗ параметра group_id
DATA_API_URL=
PORT=3000
